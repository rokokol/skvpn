#compdef skvpn
# zsh completion for skvpn. The command list is spelled here by hand; tests/run.sh checks it
# against skvpn.COMMANDS, so a command added there fails the suite until it lands here

_skvpn_profiles() {
  # Live names, not a cached list: the directory is world-listable on purpose
  local -a names
  names=(${(f)"$(skvpn ls --names 2>/dev/null)"})
  _describe -t profiles 'profile' names
}

_skvpn_split_entries() {
  # The entries of one kind that rm can take — from the list itself, minus the declared
  # ones rm cannot touch
  local kind="$1"
  local -a entries
  entries=(${(f)"$(skvpn split ls 2>/dev/null | awk -v kind="$kind" '$1 == kind && $NF != "declared" { print $2 }')"})
  compadd -- $entries
}

_skvpn() {
  local -a commands=(
    'sub:store or refresh the subscription'
    'add:add profiles from share links'
    'rm:delete profiles'
    'ls:list profiles'
    'up:start a profile'
    'down:stop the active profile'
    'restart:start the active profile over on the current base'
    'restore:start the profile chosen for boot'
    'boot:pin a profile for boot, or follow the last up'
    'split:route listed processes or addresses around the tunnel'
    'ping:measure latency through every profile with a throwaway sing-box'
    'measure:measure latency, speed and UDP loss through every profile'
    'top:watch the speed through the active tunnel live'
    'status:show the active profile and sync age'
    'export:print the config a profile runs with, or with --sfa a config for a phone'
    'tor:show the state of the Tor skvpn runs, or fetch its bridges'
    '--version:print the version'
  )

  if ((CURRENT == 2)); then
    _describe -t commands 'skvpn command' commands
    return
  fi

  case "$words[2]" in
    down)
      compadd -- --no-guard
      ;;
    up)
      # The tor profile exists once Tor is configured, before its first up writes it
      if ((CURRENT == 3)); then
        [[ -e /etc/sing-box/tor.json ]] && compadd -- tor
        _skvpn_profiles
      elif ((CURRENT == 4)) && [[ "$words[3]" == tor ]]; then
        compadd -- --via
      elif ((CURRENT == 5)) && [[ "$words[4]" == --via ]]; then
        _skvpn_profiles
      fi
      ;;
    rm)
      _skvpn_profiles
      ;;
    tor)
      if ((CURRENT == 3)); then
        local -a subcommands=(
          'status:the unit, its bootstrap, its bridges and its SOCKS port'
          'bridges:list the bridges, fetch new ones from Moat, or add and remove your own'
        )
        _describe -t commands 'tor command' subcommands
      elif ((CURRENT == 4)) && [[ "$words[3]" == bridges ]]; then
        compadd -- ls update add rm
      elif ((CURRENT == 5)) && [[ "$words[4]" == update ]]; then
        compadd -- --country
      elif ((CURRENT >= 5)) && [[ "$words[4]" == rm ]]; then
        # The own bridges are the indented two-word lines of `ls`, address second
        compadd -- ${(f)"$(skvpn tor bridges ls 2>/dev/null | awk 'NF == 2 && $2 ~ /:/ { print $2 }')"}
      fi
      ;;
    boot)
      if ((CURRENT == 3)); then
        compadd -- last
        _skvpn_profiles
      fi
      ;;
    ping)
      if ((CURRENT == 3)); then
        compadd -- set
      fi
      compadd -- --servers
      _skvpn_profiles
      ;;
    measure)
      if [[ "$words[CURRENT-1]" == --textfile ]]; then
        _files
      else
        if ((CURRENT == 3)); then
          compadd -- set
        fi
        compadd -- --textfile
        _skvpn_profiles
      fi
      ;;
    top)
      if ((CURRENT == 3)); then
        compadd -- --count
      fi
      ;;
    export)
      compadd -- --sfa --no-tailscale --tor
      _skvpn_profiles
      ;;
    status)
      if ((CURRENT == 3)); then
        compadd -- --ping
      elif ((CURRENT == 4)) && [[ "$words[3]" == --ping ]]; then
        compadd -- --servers
      fi
      ;;
    split)
      if ((CURRENT == 3)); then
        local -a subcommands=(
          'ls:list the split entries'
          'add:route a process name (default), executable path, CIDR or domain directly'
          'rm:drop split entries'
        )
        _describe -t commands 'split command' subcommands
      elif ((CURRENT == 4)) && [[ "$words[3]" == add ]]; then
        compadd -- name path ip domain
      elif ((CURRENT >= 4)) && [[ "$words[3]" == rm ]]; then
        local kind=name
        case "$words[4]" in
          name | path | ip | domain) kind="$words[4]" ;;
        esac
        if ((CURRENT == 4)); then
          compadd -- name path ip domain
        fi
        _skvpn_split_entries "$kind"
      fi
      ;;
    sub)
      if ((CURRENT == 3)); then
        local -a subcommands=(
          'set:store a subscription url and sync it'
          'sync:refresh profiles from the stored subscription'
        )
        _describe -t commands 'sub command' subcommands
      fi
      ;;
    ls)
      if ((CURRENT == 3)); then
        compadd -- --names --servers
      fi
      ;;
  esac
}

_skvpn "$@"
